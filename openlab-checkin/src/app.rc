#include <windows.h>

1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040704B0"
    BEGIN
      VALUE "CompanyName", "OpenLab Augsburg"
      VALUE "FileDescription", "OpenLab Augsburg - Mitglieder und Check-in"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductName", "OpenLab Check-in"
      VALUE "ProductVersion", "1.0.0"
      VALUE "OriginalFilename", "OpenLabCheckIn.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0407, 1200
  END
END
